COROS_API_URL=https://teameuapi.coros.com

REDIS_HOST=
REDIS_PORT=
REDIS_DB=

TELEGRAM_TOKEN=
# comma-separated telegram user ids allowed to use the bot, e.g. 123,456
TELEGRAM_ALLOWED_USER_IDS=
# telegram user id that receives admin alerts (optional)
TELEGRAM_OWNER_ID=
# UTC hour after which daily/weekly digests are sent (default 17)
TELEGRAM_DIGEST_HOUR=17

# OpenRouter (AI workout planner)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Workout planner: log the payload instead of POSTing it to Coros
WORKOUT_PLANNER_DRY_RUN=false

